generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  RECRUITER
  REVIEWER
  CONTENT_MANAGER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  passwordHash   String
  role           UserRole   @default(ADMIN)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  notes          ApplicationNote[]
  assignments    ApplicationAssignment[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Job {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  department           String
  location             String
  country              String
  employmentType       EmploymentType
  workMode             WorkMode
  salaryRange          String?
  description          String         @db.Text
  responsibilities     String         @db.Text
  requirements         String         @db.Text
  qualifications       String         @db.Text
  experience           String?
  positionsOpen        Int            @default(1)
  applicationDeadline  DateTime?
  status               JobStatus      @default(DRAFT)
  publishedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  questions            ApplicationQuestion[]
  applications         Application[]

  @@index([status])
  @@index([slug])
  @@index([country])
  @@map("jobs")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  ADDITIONAL_INFO_REQUIRED
  NOT_SELECTED
  WITHDRAWN
  HIRED
}

model Application {
  id                   String            @id @default(cuid())
  ticket               String            @unique
  jobId                String
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)

  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  nationality          String?
  countryOfResidence   String
  city                 String
  phone                String
  email                String
  currentAddress       String?

  currentJobTitle      String?
  currentEmployer      String?
  yearsExperience      Int?
  highestQualification String?
  fieldOfStudy         String?
  university           String?
  graduationYear       Int?
  skills               String?           @db.Text

  declaredAccurate     Boolean           @default(false)
  declaredUnderstand   Boolean           @default(false)
  declaredConsent      Boolean           @default(false)

  status               ApplicationStatus @default(DRAFT)
  submittedAt          DateTime?
  ipAddress            String?
  userAgent            String?
  captchaVerified      Boolean           @default(false)
  integrityScore       Int?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  educations           Education[]
  workExperiences      WorkExperience[]
  references           Reference[]
  documents            ApplicationDocument[]
  answers              ApplicationAnswer[]
  statusHistory        ApplicationStatusHistory[]
  notes                ApplicationNote[]
  assignments          ApplicationAssignment[]

  @@index([ticket])
  @@index([email])
  @@index([jobId])
  @@index([status])
  @@map("applications")
}

model Education {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution   String
  degree        String
  fieldOfStudy  String?
  country       String?
  startYear     Int?
  endYear       Int?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("educations")
}

model WorkExperience {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer         String
  jobTitle         String
  country          String?
  startDate        DateTime?
  endDate          DateTime?
  responsibilities String?     @db.Text
  reasonForLeaving String?
  createdAt        DateTime    @default(now())

  @@index([applicationId])
  @@map("work_experiences")
}

model Reference {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  organization  String
  position      String
  relationship  String?
  email         String
  phone         String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("references")
}

enum DocumentType {
  CV
  COVER_LETTER
  CERTIFICATE
  PORTFOLIO
  ID_DOCUMENT
  OTHER
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  filename      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  uploadedAt    DateTime    @default(now())

  @@index([applicationId])
  @@map("application_documents")
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  MULTIPLE_CHOICE
  CHECKBOX
  NUMBER
  DATE
}

model ApplicationQuestion {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label       String
  type        QuestionType
  required    Boolean      @default(false)
  options     String[]     @default([])
  placeholder String?
  helpText    String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  answers     ApplicationAnswer[]

  @@index([jobId])
  @@map("application_questions")
}

model ApplicationAnswer {
  id            String              @id @default(cuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value         String              @db.Text
  createdAt     DateTime            @default(now())

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@map("application_answers")
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
  @@map("application_status_history")
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String      @db.Text
  internal      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("application_notes")
}

model ApplicationAssignment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  assignedAt    DateTime    @default(now())

  @@unique([applicationId, userId])
  @@index([applicationId])
  @@index([userId])
  @@map("application_assignments")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Partner {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  website         String?
  country         String?
  partnershipType String?
  logoPath        String?
  status          ContentStatus @default(DRAFT)
  displayOrder    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@map("partners")
}

model NewsArticle {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String        @db.Text
  body           String        @db.Text
  category       String
  author         String
  coverImagePath String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@map("news_articles")
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  folder       String   @default("misc")
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([folder])
  @@map("media")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
  SPAM
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([status])
  @@map("contact_messages")
}

model PartnershipInquiry {
  id              String        @id @default(cuid())
  name            String
  company         String
  position        String?
  country         String
  email           String
  phone           String?
  partnershipType String
  message         String        @db.Text
  status          InquiryStatus @default(NEW)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())

  @@index([status])
  @@map("partnership_inquiries")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  before     String?  @db.Text
  after      String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationKind {
  APPLICATION_NEW
  PARTNERSHIP_INQUIRY
  CONTACT_MESSAGE
  JOB_CLOSING_SOON
  DOCUMENT_UPLOADED
  APPLICANT_RESPONDED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt])
  @@map("notifications")
}